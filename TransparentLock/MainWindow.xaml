<Window x:Class="TransparentLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TransparentLock"
        Title="TransparentLock"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Focusable="True"
        Background="#22000000"
        FontFamily="{StaticResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text}">

    <Window.Resources>
        <!-- Text drawn directly over the (visible) desktop needs a shadow to stay readable -->
        <DropShadowEffect x:Key="TextShadow" BlurRadius="12" ShadowDepth="0" Opacity="0.85" Color="Black"/>
    </Window.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                    Background="#66000000" BorderBrush="#33FFFFFF" BorderThickness="1">
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="30"
                           Foreground="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="{x:Static local:Strings.OverlayTitle}" Margin="0,16,0,0" HorizontalAlignment="Center"
                       FontSize="30" FontWeight="350" Foreground="#E6FFFFFF"
                       Effect="{StaticResource TextShadow}"/>

            <TextBlock x:Name="HintText" Text="{x:Static local:Strings.OverlayHint}" Margin="0,6,0,0"
                       HorizontalAlignment="Center" FontSize="14" Foreground="#C0FFFFFF"
                       Effect="{StaticResource TextShadow}"/>

            <!-- Password panel appears only in the password phase / lockout -->
            <Border x:Name="PasswordPanel" Visibility="Collapsed" Width="340" Margin="0,24,0,0" Padding="24,20"
                    CornerRadius="12" BorderThickness="1"
                    Background="{DynamicResource Brush.OverlayCard}"
                    BorderBrush="{DynamicResource Brush.OverlayCardBorder}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ShakeTransform"/>
                </Border.RenderTransform>

                <StackPanel>
                    <TextBlock Text="{x:Static local:Strings.OverlayEnterPassword}" FontSize="16" FontWeight="SemiBold"/>

                    <PasswordBox x:Name="PasswordBox" Margin="0,12,0,0" FontSize="16" Padding="10,8"
                                 KeyDown="PasswordBox_OnKeyDown"
                                 PasswordChanged="PasswordBox_OnPasswordChanged"/>

                    <TextBlock x:Name="StatusText" Visibility="Collapsed" Margin="0,10,0,0"
                               FontSize="13" TextWrapping="Wrap"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Track}"/>
                        <Border x:Name="CountdownBar" Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Accent}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CountdownScale" ScaleX="1"/>
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock x:Name="CountdownText" Grid.Column="1" Margin="10,0,0,0" MinWidth="30"
                                   TextAlignment="Right" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
