<Window x:Class="TransparentLock.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TransparentLock"
        Title="{x:Static local:Strings.SettingsTitle}"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="14"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        Icon="pack://application:,,,/Resources/TransparentLock.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,20,24,20">

                <!-- Header -->
                <DockPanel Margin="0,0,0,16">
                    <Image Source="pack://application:,,,/Resources/TransparentLock.ico" Width="36" Height="36"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TransparentLock" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static local:Strings.SettingsSubtitle}" FontSize="13"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Security notice -->
                <Border CornerRadius="6" BorderThickness="1" Padding="14,12"
                        Background="{DynamicResource Brush.WarningBg}"
                        BorderBrush="{DynamicResource Brush.WarningBorder}">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" VerticalAlignment="Top"
                                   Margin="0,2,12,0" Foreground="{DynamicResource Brush.Warning}"/>
                        <StackPanel>
                            <TextBlock Text="{x:Static local:Strings.NoticeTitle}" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Text="{x:Static local:Strings.NoticeText}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Password -->
                <TextBlock Text="{x:Static local:Strings.SectionPassword}" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="PasswordStatusPill" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="PasswordStatusPillText" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Button x:Name="RemovePasswordButton" Content="{x:Static local:Strings.Remove}" Margin="8,0,0,0"
                                        Style="{StaticResource SubtleButton}"
                                        Click="OnRemovePasswordClick"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.PasswordTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="PasswordStatusText" Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <DockPanel Style="{StaticResource SettingRow}">
                            <PasswordBox x:Name="NewPasswordBox" DockPanel.Dock="Right" Width="190" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.NewPasswordTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{x:Static local:Strings.NewPasswordDescription}" Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <DockPanel Style="{StaticResource SettingRow}">
                            <PasswordBox x:Name="ConfirmPasswordBox" DockPanel.Dock="Right" Width="190" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.ConfirmPasswordTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{x:Static local:Strings.ConfirmPasswordDescription}" Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Locking -->
                <TextBlock Text="{x:Static local:Strings.SectionLocking}" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Width="190" VerticalAlignment="Center"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                                     IsUndoEnabled="False" ContextMenu="{x:Null}"
                                     PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                                     PreviewKeyUp="HotkeyBox_OnPreviewKeyUp"
                                     GotKeyboardFocus="HotkeyBox_OnGotKeyboardFocus"
                                     LostKeyboardFocus="HotkeyBox_OnLostKeyboardFocus"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.HotkeyTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{x:Static local:Strings.HotkeyDescription}"
                                           Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox x:Name="AutoLockIdleBox" DockPanel.Dock="Right" Width="100" MaxLength="6" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.AutoLockTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{x:Static local:Strings.AutoLockDescription}" Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox x:Name="PasswordPhaseBox" DockPanel.Dock="Right" Width="100" MaxLength="4" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.PromptDurationTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{x:Static local:Strings.PromptDurationDescription}" Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox x:Name="WindowsLockAfterBox" DockPanel.Dock="Right" Width="100" MaxLength="4" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.WindowsLockTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{x:Static local:Strings.WindowsLockDescription}"
                                           Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Brute force -->
                <TextBlock Text="{x:Static local:Strings.SectionBruteForce}" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox x:Name="MaxAttemptsBox" DockPanel.Dock="Right" Width="100" MaxLength="3" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.AttemptsTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{x:Static local:Strings.AttemptsDescription}" Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <DockPanel Style="{StaticResource SettingRow}">
                            <TextBox x:Name="InitialBackoffBox" DockPanel.Dock="Right" Width="100" MaxLength="5" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.BackoffTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{x:Static local:Strings.BackoffDescription}" Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- General -->
                <TextBlock Text="{x:Static local:Strings.SectionGeneral}" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <CheckBox x:Name="AutostartToggle" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.AutostartTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{x:Static local:Strings.AutostartDescription}"
                                           Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <DockPanel Style="{StaticResource SettingRow}">
                            <CheckBox x:Name="KeepAwakeToggle" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitch}"/>
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Strings.KeepAwakeTitle}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{x:Static local:Strings.KeepAwakeDescription}"
                                           Style="{StaticResource RowDescription}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Padding="24,16" BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.Footer}"
                BorderBrush="{DynamicResource Brush.Divider}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{x:Static local:Strings.Cancel}" MinWidth="96" IsCancel="True" Click="OnCancelClick"/>
                    <Button Content="{x:Static local:Strings.Save}" MinWidth="96" Margin="8,0,0,0" IsDefault="True"
                            Style="{StaticResource AccentButton}" Click="OnSaveClick"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           FontSize="13" Foreground="{DynamicResource Brush.Danger}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
