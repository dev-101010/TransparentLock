    <SolidColorBrush x:Key="Brush.FocusStroke" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#55000000"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#88000000"/>
    <SolidColorBrush x:Key="Brush.Track" Color="#1F000000"/>
</ResourceDictionary>
