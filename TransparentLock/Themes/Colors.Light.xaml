    <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.DangerBg" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="Brush.SuccessBg" Color="#DFF6DD"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#9D5D00"/>
    <SolidColorBrush x:Key="Brush.WarningBg" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#F2DFA7"/>
    <SolidColorBrush x:Key="Brush.OverlayCard" Color="#F5F9F9F9"/>
