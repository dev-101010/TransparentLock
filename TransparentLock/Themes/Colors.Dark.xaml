<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (Windows 11 style). Keys must match Colors.Light.xaml -->
    <SolidColorBrush x:Key="Brush.Window" Color="#202020"/>
    <SolidColorBrush x:Key="Brush.Footer" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#363636"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#353535"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#48B2E9"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#42A1D2"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#000000"/>
    <SolidColorBrush x:Key="Brush.Control" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#333333"/>
